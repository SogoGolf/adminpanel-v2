# Copy this to .env.local and fill in your values

# API Provider: 'cosmosdb' or 'mongodb'
VITE_API_PROVIDER=cosmosdb

# CosmosDB API (current)
VITE_SOGO_API_URL=https://sogo-api.azure-api.net/sogo-general
VITE_AZURE_API_KEY=your_api_key_here

# MongoDB API (future)
VITE_MONGODB_API_URL=https://your-mongodb-api.com

# Optional non-production banner
VITE_APP_ENV=production
VITE_ENV_BANNER_TEXT=

# Firebase sign-in project. Leave all of these unset to use production (sogo-golf).
# Set all of them to use another project; the DEV site uses sogogolf-dev (see scripts/deploy-dev.sh).
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
